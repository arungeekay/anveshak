# ANVESHAK environment template — copy to .env and fill in. No secrets in git.

# --- App ---
ENVIRONMENT=dev
APP_VERSION=0.1.0

# --- Data layer (ADR-1) ---
DUCKDB_PATH=build/anveshak.duckdb
DATA_SEED=42

# --- LLM (ADR-4): quickml | ollama ---
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# QuickML LLM Serving (fill from console API Details; never commit the real key).
# Qwen 2.5-14B is deprecated on QuickML -> use GLM-4.7-Flash (platform's replacement).
QUICKML_ENDPOINT=
QUICKML_API_KEY=
QUICKML_MODEL=glm-4.7-flash
QUICKML_ORG=

# --- Embeddings (ADR-5) ---
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Catalyst ---
# Project 'anveshak', India (IN) data center, org arungkind.
CATALYST_PROJECT_ID=54121000000013049
CATALYST_DC=in
